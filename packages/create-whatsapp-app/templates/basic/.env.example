# Leave these empty to run in mock mode: no Meta account needed, the chat on
# http://localhost:3000 plays the customer and your bot code runs for real.
#
# Fill them in to talk to real WhatsApp users:
# https://meta-cloud-api.site/getting-started/configuration
CLOUD_API_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Any string. Paste the same value into Meta's webhook "Verify token" field.
WEBHOOK_VERIFICATION_TOKEN={{VERIFY_TOKEN}}
# Meta App Secret. When set, webhook POSTs without a valid X-Hub-Signature-256 are rejected.
APP_SECRET=
