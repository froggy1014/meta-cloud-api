# Leave these empty to run in mock mode: no Meta account needed, the chat on
# http://localhost:3000 plays the customer and your bot code runs for real.
#
# Fill them in to talk to real WhatsApp users:
# https://meta-cloud-api.site/getting-started/configuration
CLOUD_API_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Any string. Paste the same value into Meta's webhook "Verify token" field.
WEBHOOK_VERIFICATION_TOKEN={{VERIFY_TOKEN}}
# Required in live mode: Meta App Secret used to verify webhook POSTs.
APP_SECRET=

# Live dashboard login: username admin, password below. Keep this private.
DASHBOARD_PASSWORD={{DASHBOARD_PASSWORD}}

# Claude (https://console.anthropic.com/settings/keys). Leave empty and the
# agent echoes messages back instead, so mock mode works with no secrets.
ANTHROPIC_API_KEY=
# Optional: any Claude model ID. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
